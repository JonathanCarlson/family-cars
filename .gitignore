# ── SECRETS AND PLAINTEXT DATA — never commit these ──────────────────────────
#
# The pages are public on GitHub Pages; their privacy comes entirely from the
# access key in the URL fragment. Committing a key here would make the encrypted
# bundles readable by anyone who finds the repo, which defeats the whole design.

# Access keys — the tokens in the shareable  cars.html#k=…  /  jordyn.html#k=…
# URLs. Kept out of git so the links stay private AND stable across rebuilds.
build/cars-key.txt
build/jordyn-key.txt

# Spoken passphrases (the alternate way in when a link loses its #fragment) and
# the feed tokens that form the unguessable plaintext-feed URLs. Same reasoning:
# publishing either one would hand over the roster.
build/cars-pass.txt
build/jordyn-pass.txt
build/cars-feed.txt
build/jordyn-feed.txt

# Plaintext rosters. ONLY the encrypted blobs (data/*.enc.json) ship.
build/cars.json
build/jordyn.json
# The complete market sweep, used only to build the feed. Same reasoning: it is
# plaintext roster data and must not be committed.
build/jordyn-all.json

# Nightly backups written before each refresh.
build/*.bak-*
build/*.json.bak-*

# ── Local noise ──────────────────────────────────────────────────────────────
node_modules/
.DS_Store
Thumbs.db
*.log
scratch/
